# Compiled CUDA binaries
*.cubin
!*_handtuned.sm_86.cubin

# Probe run artifacts (regenerated each run)
scripts/probe/*.log
scripts/probe/*.rds
scripts/probe/eval_logs/

# Generated SASS disassembly (keep hand-tuned variants)
*.cuasm
!*_handtuned.cuasm

# Compiled executables (not source files)
bench
bench_*
# The gate's run record (#186) is machine-specific measurement, so it stays
# local. It is already swallowed by `bench_*` above, but only by accident of
# the directory name -- stated explicitly so narrowing that rule cannot start
# committing one developer's thermal history.
results/bench_regress/
!bench_*.cu
!scripts/bench_*.R
!scripts/bench_*.py
# The `bench` / `bench_*` rules above are for compiled binaries, but
# they also swallow the scripts/bench/ R-source directory. Re-include
# it and its R sources (the compiled kernel `bench` executables live
# under kernels/, not here, so they stay ignored).
!scripts/bench/
!scripts/bench/*.R
# bench_all.R reads its corpus spec from scripts/bench/bench_all.yml; the
# `bench_*` rule would swallow the .yml (the *.R re-include above is R-only).
!scripts/bench/*.yml
# The cuasmR package R/ sources include bench_*.R files (issue #134
# measurement migration); re-include them — they are library code, not
# compiled bench artifacts.
!R/cuasmR/R/bench_*.R
!tests/bench_regress/
!tests/bench_regress/**
# tests/bench_all/ (issue #124) is swallowed by `bench_*` too — re-include
# the GPU-free unit tests (results/bench_all/ generated output stays ignored).
!tests/bench_all/
!tests/bench_all/**
test_dense_manual
test_mma_sp
test_inplace_race
test_counter
test_persistent
test_persistent_debug
!test_*.cu
verify_wmma_ab_layout
verify_wmma_layout

# Cubin backups
*.cubin.baseline

# Stray temp file from prior session (zero-byte tool error artifact)
, None:0,parameters

# Hugging Face publish artifact: SHA256SUMS is regenerated at upload
# time by scripts/publish_hf.R; never committed (see WS4, issue #109).
SHA256SUMS

# Python
__pycache__/
*.pyc
!scripts/bench_regress.py
!scripts/bench_flash_all.py

# CuAssembler working artifacts
*.cuasm.orig

# Raw SASS reference (generated on-demand via scripts/build.py)
*.sass

# Claude Code / context
.claude/

# Secrets / local environment (never commit real tokens; .env.example is the tracked template)
.env
!.env.example

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
*.bak

# Quarto build output
docs/analysis/_output/

# OS
.DS_Store
Thumbs.db

# cymatic R-script outputs at project root
cymatic_mapping.csv
cymatic_mapping.rds
cymatic_locality.csv

# IMMA hand-tune experiment artifacts (#96 sub-task A, negative result; the
# generator script was removed after the negative result — recover from git
# history if a rerun is ever needed).
*.imma_s04.sm_86.cubin
*.imma_s02.sm_86.cubin

# phase6 / cuda-oxide spike
# Keep the small comparison artifacts so the README's measured results are
# reproducible from disk, but exclude the upstream NVlabs/cuda-oxide example
# copy (NVIDIA Apache-2.0 — not ours, fetched fresh by run_oxide.sh).
experiments/rust-experiments/vecadd_oxide/
!experiments/rust-experiments/**/*.cubin
!experiments/rust-experiments/**/*.sass
!experiments/rust-experiments/**/*.ptx
# Large data files inside phase6 sub-experiments (regenerable from R scripts)
experiments/rust-experiments/**/perm.bin
experiments/rust-experiments/**/traces.bin

# Session handoff scratchpad — local and intra-session only, never committed.
# docs/CONTINUE_HERE.md is a rolling per-author handoff: it records the last
# session's state and next steps for the next session on THIS machine. It churns
# every session and describes mutable local state (branch, worktree, open PRs),
# so a committed copy is stale the moment it lands and misleads anyone who is not
# its author. Untracked 2026-07-30; the 48 commits that previously carried it stay
# in history (`git log --all -- docs/CONTINUE_HERE.md`).
docs/CONTINUE_HERE.md

# Quarto site build (#187). The site is generated from the tracked sources on
# every push to main and served from GitHub Pages; the rendered copy is a build
# artifact, and committing it would mean reviewing 65 generated files per docs
# change. `/.quarto/` and the ipynb rule are Quarto's own, added by the tool.
/_site/
/.quarto/
**/*.quarto_ipynb
